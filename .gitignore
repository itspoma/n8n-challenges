# dependencies
/node_modules

# Next.js
/.next/
/out/

# production
/build

# local configuration
.env*
!.env.example

# logs and editor files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# TypeScript
*.tsbuildinfo
next-env.d.ts

# generated blog image variants (scripts/blog-images.mjs). The publisher's WebP originals match
# the .webp rule but are committed; Git keeps tracking them, and adding one by hand needs `git add -f`.
/public/blog/**/*.webp
/public/blog/**/*.og.jpg
